<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         PADRE: hereda la versionamiento, plugins y configuración de
         Spring Boot (surefire, repackage, java compiler, etc.)
         =================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <!-- ===================================================================
         IDENTIFICACIÓN DEL PROYECTO
         =================================================================== -->
    <groupId>com.eventpass</groupId>
    <artifactId>eventpass</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>EventPass</name>
    <description>API REST de venta y validación de tickets para eventos (EventPass)</description>
    <url>https://github.com/eventpass</url>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ===================================================================
         DEPENDENCIAS
         =================================================================== -->
    <dependencies>

        <!-- Web: endpoints REST (Spring MVC + embebido Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Data JPA: Hibernate, repositorios y conexión a la BD -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validación: @Valid / @NotBlank sobre los DTO de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Manejo uniforme de errores HTTP en un @RestControllerAdvice -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- H2: motor de aplicación. Corre en archivo local (ver
             application.properties) y se inspecciona desde /h2-console -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Pruebas: JUnit 5, Mockito y MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         BUILD
         =================================================================== -->
    <build>
        <plugins>

            <!-- Empaqueta el proyecto en un .jar ejecutable (mvn package) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
